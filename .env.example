# CRM authentication. Generate a long random value for BETTER_AUTH_SECRET.
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:7800
SQLITE_PATH=./data/crm.sqlite
APP_TIMEZONE=America/Argentina/Mendoza

# Use these only once with `npm run db:create-admin`, then remove them from the environment.
ADMIN_NAME=
ADMIN_LOGIN=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Existing website contact-form notifications (optional for CRM).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
